@{
    ViewData["Title"] = "Too Many Attempts";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h2>Too many attempts</h2>
        <div class="card p-4">
            <p>There have been too many log-in attempts from this network. Wait a minute, then try again.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-rosebank w-100">Back to log in</a>
        </div>
    </div>
</div>
