@model Admin
@{
    ViewData["Title"] = "Add Admin";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Add admin", BackUrl = Url.Action("Index"), BackText = "Admins" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="off" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Temporary password</label>
            <div class="input-group">
                <input id="password" name="password" type="password" class="form-control" minlength="8" autocomplete="new-password" required aria-describedby="passwordHelp" />
                <button type="button" class="btn btn-outline-secondary" data-password-toggle="password" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
            </div>
            <div id="passwordHelp" class="form-text">At least 8 characters.</div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Add admin</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
