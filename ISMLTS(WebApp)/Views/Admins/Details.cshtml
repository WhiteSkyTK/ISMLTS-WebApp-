@model Admin
@{
    ViewData["Title"] = "Admin Details";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.Username, Subtitle = "Admin", BackUrl = Url.Action("Index"), BackText = "Admins", ActionUrl = Url.Action("Edit", new { id = Model.AdminId }), ActionText = "Edit", ActionIcon = "bi-pencil" }' />

<div class="panel form-panel">
    <dl class="row detail-list mb-0">
        <dt class="col-sm-4">Username</dt>
        <dd class="col-sm-8">@Model.Username</dd>
        <dt class="col-sm-4">Role</dt>
        <dd class="col-sm-8 mb-0">@Model.Role</dd>
    </dl>
</div>

<partial name="_UserSecurity" model="new UserSecurityModel { Role = Roles.Admin, Id = Model.AdminId, Name = Model.Username, TwoFactorEnabled = Model.TwoFactorEnabled, MustChangePassword = Model.MustChangePassword }" />
