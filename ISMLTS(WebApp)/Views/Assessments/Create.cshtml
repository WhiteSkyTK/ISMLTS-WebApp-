@model Assessment
@{
    ViewData["Title"] = "Add Assessment";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Add assessment", Subtitle = Model.Module?.Code, BackUrl = Url.Action("ForModule", new { moduleId = Model.ModuleId }), BackText = "Assessments" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_AssessmentFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Add assessment</button>
            <a asp-action="ForModule" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
