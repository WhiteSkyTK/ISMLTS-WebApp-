@model IEnumerable<ISMLTS_WebApp_.Models.Module>
@{
    ViewData["Title"] = "Assessments";
}

<h1>Assessments</h1>
<p class="text-muted">Pick a module to manage assessments.</p>
<div class="row g-3">
    @foreach (var m in Model)
    {
        <div class="col-md-4">
            <a asp-action="ForModule" asp-route-moduleId="@m.ModuleId" class="quick-action-btn w-100">
                <i class="bi bi-journal-check"></i><span>@m.Code — @m.Name</span>
            </a>
        </div>
    }
</div>
@if (!Model.Any())
{
    <p class="text-muted">No modules yet — add one under Modules first.</p>
}