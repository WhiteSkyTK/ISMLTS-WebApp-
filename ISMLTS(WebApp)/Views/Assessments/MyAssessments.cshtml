@model List<MyAssessmentRow>
@using ISMLTS_WebApp_.Services
@{
    ViewData["Title"] = "My Assessments";
    ViewData["FilterLabel"] = "Filter by name, module or type";
    var toDo = Model.Count(r => r.Status == "Not Submitted");
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "My assessments", Subtitle = "Everything set for your modules, soonest first." }' />

<div class="panel">
    @if (Model.Any())
    {
        <div class="stat-inline">
            <div><strong>@toDo</strong><span class="small text-muted">still to submit</span></div>
            <div><strong>@(Model.Count - toDo)</strong><span class="small text-muted">submitted</span></div>
        </div>
        <partial name="_TableFilter" model='"#myAssessmentsTable"' />
        <div class="table-scroll">
            <table id="myAssessmentsTable" class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Assessment</th>
                        <th scope="col">Type</th>
                        <th scope="col">Due</th>
                        <th scope="col">Status</th>
                        <th scope="col">Mark</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var overdue = r.Status == "Not Submitted" && DueDates.IsOverdue(r.DueDate, DateTime.Today);
                        <tr>
                            <td>
                                <span class="fw-medium">@r.Name</span>
                                <span class="table-row-sub font-monospace">@r.ModuleCode</span>
                            </td>
                            <td><span class="badge task-badge task-@r.Type.ToLowerInvariant()">@r.Type</span></td>
                            <td>
                                @r.DueDate.ToString("ddd, dd MMM")
                                <span class="table-row-sub @(overdue ? "text-danger" : null)">@DueDates.Describe(r.DueDate, DateTime.Today)</span>
                            </td>
                            <td><partial name="_SubmissionStatus" model="r.Status" /></td>
                            <td>
                                @if (r.Mark != null)
                                {
                                    <span class="fw-semibold">@MarkRules.Format(r.Mark.Score)/@MarkRules.Format(r.Mark.MaxScore)</span> <span class="text-muted">(@r.Mark.Percentage%)</span>
                                    @if (!string.IsNullOrEmpty(r.Mark.Feedback))
                                    {
                                        <span class="table-row-sub ticket-message"><i class="bi bi-chat-left-text" aria-hidden="true"></i> @r.Mark.Feedback</span>
                                    }
                                }
                                else if (r.Status != "Not Submitted" && !r.MarksReleased)
                                {
                                    <span class="small text-muted">Waiting for marks</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (r.Status == "Not Submitted")
                                {
                                    <a asp-action="Submit" asp-route-id="@r.AssessmentId" class="btn btn-rosebank btn-sm text-nowrap"><i class="bi bi-upload" aria-hidden="true"></i> Submit</a>
                                }
                                else
                                {
                                    <a asp-action="Submit" asp-route-id="@r.AssessmentId" class="btn btn-outline-rosebank btn-sm text-nowrap"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Update</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0" data-filter-empty hidden>Nothing matches that filter.</p>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-journal-check", Title = "Nothing set yet", Message = "Assessments show here when your lecturers add them." }' />
    }
</div>
