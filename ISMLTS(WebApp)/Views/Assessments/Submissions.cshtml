@model ISMLTS_WebApp_.Models.AssessmentSubmissionsViewModel
@{
    ViewData["Title"] = "Submissions";
}

<h1>@Model.AssessmentDisplay</h1>
<p class="text-muted">Due @Model.DueDate.ToString("ddd, dd MMM yyyy")</p>

<table class="table">
    <thead><tr><th>Student</th><th>Status</th><th>Submitted</th><th>Link</th></tr></thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.FullName</td>
                <td>
                    @if (row.Status == "Not Submitted")
                    {
                        <span class="badge bg-secondary">Not Submitted</span>
                    }
                    else if (row.Status == "Late")
                    {

                        <span class="badge bg-danger">Late</span>
                    }
                    else
                    {

                        <span class="badge bg-success">Submitted</span>
                    }
                </td>
                <td>@(row.SubmittedAt?.ToString("dd MMM, HH:mm") ?? "—")</td>
                <td>@if (!string.IsNullOrEmpty(row.Link)) {
                <a href="@row.Link" target="_blank" rel="noopener">Open</a>
            } else
            {

                <span>—</span>
            }
</td>
        </tr>
                }
    </tbody>
</table>
@if (!Model.Rows.Any())
{
    <p class="text-muted">No students enrolled in this module yet.</p>
}