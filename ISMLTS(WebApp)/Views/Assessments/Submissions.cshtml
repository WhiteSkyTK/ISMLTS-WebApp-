@model AssessmentSubmissionsViewModel
@using ISMLTS_WebApp_.Services
@{
    ViewData["Title"] = "Submissions";
    ViewData["FilterLabel"] = "Find a student";
    var submitted = Model.Rows.Count(r => r.Status != "Not Submitted");
    var late = Model.Rows.Count(r => r.Status == "Late");
    var subtitle = $"Due {Model.DueDate:ddd, dd MMM yyyy} · {DueDates.Describe(Model.DueDate, DateTime.Today)}";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.AssessmentDisplay, Subtitle = subtitle, BackUrl = Url.Action("ForModule", new { moduleId = Model.ModuleId }), BackText = "Assessments" }' />

<div class="panel">
    @if (Model.Rows.Any())
    {
        <div class="stat-inline">
            <div><strong>@submitted of @Model.Rows.Count</strong><span class="small text-muted">submitted</span></div>
            <div><strong>@late</strong><span class="small text-muted">late</span></div>
        </div>
        <partial name="_TableFilter" model='"#submissionsTable"' />
        <div class="table-scroll">
            <table id="submissionsTable" class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Status</th>
                        <th scope="col">Submitted</th>
                        <th scope="col"><span class="visually-hidden">Link</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.OrderBy(r => r.FullName))
                    {
                        <tr>
                            <td class="fw-medium">@row.FullName</td>
                            <td><partial name="_SubmissionStatus" model="row.Status" /></td>
                            <td>@(row.SubmittedAt?.ToLocalTime().ToString("dd MMM, HH:mm") ?? "—")</td>
                            <td class="text-end">
                                @if (!string.IsNullOrEmpty(row.Link))
                                {
                                    <a href="@row.Link" target="_blank" rel="noopener noreferrer" class="btn btn-outline-rosebank btn-sm text-nowrap"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open work</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0" data-filter-empty hidden>No students match that name.</p>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-people", Title = "Nobody is enrolled in this module yet", Message = "An admin enrols students under Modules." }' />
    }
</div>
