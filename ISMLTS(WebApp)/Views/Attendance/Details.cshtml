@model AttendanceDetailsViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["AllowRemove"] = true;
    var present = Model.Session.Records.Count;
    var total = present + Model.Absent.Count;
    var subtitle = $"{Model.Session.StartedAt.ToLocalTime():dddd, dd MMM yyyy HH:mm} · {present} of {total} present";
    var header = new PageHeaderModel { Title = $"{Model.Session.Module?.Code} register", Subtitle = subtitle, BackUrl = Url.Action("ForModule", new { moduleId = Model.Session.ModuleId }), BackText = "Sessions" };
    if (Model.Session.IsOpen)
    {
        header.ActionUrl = Url.Action("Live", new { id = Model.Session.SessionId });
        header.ActionText = "Show QR code";
        header.ActionIcon = "bi-qr-code";
    }
}

<partial name="_PageHeader" model="header" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <h5><i class="bi bi-check2-circle" aria-hidden="true"></i> Present (@present)</h5>
            <partial name="_Records" model="Model.Session" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h5><i class="bi bi-person-x" aria-hidden="true"></i> Absent (@Model.Absent.Count)</h5>
            @if (!Model.Absent.Any())
            {
                <p class="text-muted mb-0"><i class="bi bi-emoji-smile" aria-hidden="true"></i> Everyone is here.</p>
            }
            @foreach (var s in Model.Absent)
            {
                <form asp-action="MarkPresent" asp-route-id="@Model.Session.SessionId" method="post" class="d-flex justify-content-between align-items-center gap-2 py-1 border-bottom">
                    <input type="hidden" name="studentId" value="@s.StudentId" />
                    <span>@s.FullName</span>
                    <button type="submit" class="btn btn-outline-success btn-sm text-nowrap" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Present</button>
                </form>
            }
        </div>
    </div>
</div>
