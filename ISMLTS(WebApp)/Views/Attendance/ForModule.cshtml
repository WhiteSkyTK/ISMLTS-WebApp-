@model IEnumerable<AttendanceSession>
@using System.Globalization
@{
    ViewData["Title"] = "Attendance";
    string moduleDisplay = ViewBag.ModuleDisplay;
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Attendance", Subtitle = moduleDisplay, BackUrl = Url.Action("Index"), BackText = "All modules" }' />

<div class="panel mb-4">
    <form asp-action="Start" method="post" data-geo-form class="d-flex flex-wrap align-items-center gap-3">
        <input type="hidden" name="moduleId" value="@ViewBag.ModuleId" />
        <input type="hidden" name="latitude" />
        <input type="hidden" name="longitude" />
        <button type="submit" class="btn btn-rosebank btn-lg" data-loading="Starting…"><i class="bi bi-qr-code" aria-hidden="true"></i> Start attendance session</button>
        <p class="small text-muted mb-0 flex-grow-1" data-geo-status><i class="bi bi-geo-alt" aria-hidden="true"></i> Your browser asks for your location. It is saved as the classroom position that student scans are checked against.</p>
    </form>
</div>

<div class="panel">
    <h2 class="h5"><i class="bi bi-clock-history" aria-hidden="true"></i> Past sessions</h2>
    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="table align-middle mb-0" data-sortable>
                <thead>
                    <tr>
                        <th scope="col" data-sort="number" aria-sort="descending">Started</th>
                        <th scope="col" data-sort="number">Present</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td data-sort-value="@s.StartedAt.Ticks.ToString(CultureInfo.InvariantCulture)">@s.StartedAt.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm")</td>
                            <td>@s.Records.Count</td>
                            <td>
                                @if (s.IsCancelled)
                                {
                                    <span class="badge text-bg-warning">Cancelled class</span>
                                }
                                else if (s.IsOpen)
                                {
                                    <span class="badge text-bg-success">Open</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Closed</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (s.IsOpen)
                                    {
                                        <a asp-action="Live" asp-route-id="@s.SessionId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Show QR code"><i class="bi bi-qr-code" aria-hidden="true"></i><span class="visually-hidden">Show the QR code</span></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@s.SessionId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Register"><i class="bi bi-list-check" aria-hidden="true"></i><span class="visually-hidden">Open the register</span></a>
                                    <form asp-action="SetCancelled" asp-route-id="@s.SessionId" method="post" data-confirm="@(s.IsCancelled ? "Count this class towards attendance again?" : "Mark this as a cancelled class? It stops counting towards attendance; the scans are kept.")" data-confirm-tone="primary">
                                        <input type="hidden" name="cancelled" value="@(s.IsCancelled ? "false" : "true")" />
                                        <button type="submit" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="@(s.IsCancelled ? "Count this class again" : "Cancelled class")"><i class="bi @(s.IsCancelled ? "bi-arrow-counterclockwise" : "bi-calendar-x")" aria-hidden="true"></i><span class="visually-hidden">@(s.IsCancelled ? "Count this class again" : "Mark as a cancelled class")</span></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-qr-code-scan", Title = "No sessions yet", Message = "Start a session in class and students scan the QR code to mark themselves present." }' />
    }
</div>

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
