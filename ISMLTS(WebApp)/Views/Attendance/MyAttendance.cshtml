@model List<MyAttendanceRow>
@{
    ViewData["Title"] = "My Attendance";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "My attendance", Subtitle = "Sessions you were marked present for, per module.", ActionUrl = Url.Action("Scan"), ActionText = "Enter a code", ActionIcon = "bi-qr-code-scan" }' />

<div class="panel">
    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="table align-middle mb-0" data-sortable>
                <thead>
                    <tr>
                        <th scope="col" data-sort="text">Module</th>
                        <th scope="col" data-sort="number">Attended</th>
                        <th scope="col" data-sort="number">Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="fw-medium">@row.ModuleDisplay</td>
                            <td class="text-nowrap" data-sort-value="@row.Attended">@row.Attended of @row.Total</td>
                            <td data-sort-value="@row.Percentage">
                                <div class="d-flex align-items-center gap-2">
                                    <progress class="w-100" value="@row.Percentage" max="100" aria-label="@row.ModuleDisplay attendance">@row.Percentage%</progress>
                                    <span class="small text-muted">@row.Percentage%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-journal-x", Title = "You are not enrolled in any modules yet", Message = "Your attendance shows here once an admin enrols you." }' />
    }
</div>
