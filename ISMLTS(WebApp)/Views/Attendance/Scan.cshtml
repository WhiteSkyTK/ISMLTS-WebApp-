@model string?
@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <partial name="_PageHeader" model='new PageHeaderModel { Title = "Mark attendance", Subtitle = "Scan the QR code in class, or type the 6-character code your lecturer shows.", BackUrl = Url.Action("MyAttendance"), BackText = "My attendance" }' />
        @if (TempData["ScanError"] is string error)
        {
            <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @error</div>
        }
        <div class="panel">
            <form asp-action="Scan" method="post" data-geo-form>
                <input type="hidden" name="latitude" />
                <input type="hidden" name="longitude" />
                <input type="hidden" name="accuracy" />
                <div class="mb-3">
                    <label for="code" class="form-label">Session code</label>
                    <input id="code" name="code" value="@Model" class="form-control form-control-lg text-uppercase font-monospace text-center" maxlength="6" autocomplete="off" autocapitalize="characters" spellcheck="false" required />
                </div>
                <button type="submit" class="btn btn-rosebank btn-lg w-100" data-loading="Checking…"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark me present</button>
                <p class="small text-muted mt-3 mb-0" data-geo-status>
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    Your browser asks for your location. It is only used to confirm you are in class and is saved with this attendance record.
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
