@model Course
@{
    ViewData["Title"] = "Add Course";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Add course", BackUrl = Url.Action("Index"), BackText = "Courses" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_CourseFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Add course</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
