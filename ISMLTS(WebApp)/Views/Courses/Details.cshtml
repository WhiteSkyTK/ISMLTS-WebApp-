@model Course
@{
    ViewData["Title"] = "Course Details";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.Code, Subtitle = Model.Name, BackUrl = Url.Action("Index"), BackText = "Courses", ActionUrl = Url.Action("Edit", new { id = Model.CourseId }), ActionText = "Edit", ActionIcon = "bi-pencil" }' />

<div class="panel">
    <h5><i class="bi bi-journal-bookmark" aria-hidden="true"></i> Modules in this course</h5>
    @if (Model.Modules.Any())
    {
        <div class="table-scroll">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Name</th>
                        <th scope="col">Term</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Modules.OrderBy(m => m.Term).ThenBy(m => m.Code))
                    {
                        <tr>
                            <td class="font-monospace"><a asp-controller="Modules" asp-action="Details" asp-route-id="@m.ModuleId">@m.Code</a></td>
                            <td>@m.Name</td>
                            <td>@(m.Term == "Term2" ? "Term 2" : "Term 1")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-journal-bookmark", Title = "No modules in this course yet", Message = "Set the course when you add or edit a module." }' />
    }
</div>
