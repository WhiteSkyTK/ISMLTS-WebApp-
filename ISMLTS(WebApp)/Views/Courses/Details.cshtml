@model Course
@{
    ViewData["Title"] = "Course Details";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.Code, Subtitle = Model.Name, BackUrl = Url.Action("Index"), BackText = "Courses", ActionUrl = Url.Action("Enrol", new { id = Model.CourseId }), ActionText = "Enrol students", ActionIcon = "bi-person-plus" }' />

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Modules" asp-route-id="@Model.CourseId" class="btn btn-outline-rosebank"><i class="bi bi-journal-plus" aria-hidden="true"></i> Add or remove modules</a>
    <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-outline-rosebank"><i class="bi bi-pencil" aria-hidden="true"></i> Edit course</a>
</div>

@if (Model.Modules.Any())
{
    <div class="row g-4">
        @foreach (var term in new[] { "Term1", "Term2" })
        {
            var termModules = Model.Modules.Where(m => m.Term == term).OrderBy(m => m.Code).ToList();
            <div class="col-lg-6">
                <div class="panel h-100">
                    <h2 class="h5"><i class="bi bi-calendar3" aria-hidden="true"></i> @(term == "Term2" ? "Term 2" : "Term 1") <span class="small text-muted fw-normal">(@termModules.Count)</span></h2>
                    @if (termModules.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var m in termModules)
                            {
                                <li class="py-1 border-bottom">
                                    <a asp-controller="Modules" asp-action="Details" asp-route-id="@m.ModuleId" class="font-monospace">@m.Code</a>
                                    <span class="ms-1">@m.Name</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No @(term == "Term2" ? "Term 2" : "Term 1") modules yet.</p>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="panel">
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-journal-bookmark", Title = "No modules in this course yet", Message = "Pick the modules that make up this course, then enrol students in all of them at once.", ActionUrl = Url.Action("Modules", new { id = Model.CourseId }), ActionText = "Add modules" }' />
    </div>
}
