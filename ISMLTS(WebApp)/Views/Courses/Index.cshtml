@model PagedList<Course>
@{
    ViewData["Title"] = "Courses";
    ViewData["SearchLabel"] = "Search by code or name";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Courses", Subtitle = "Qualifications that group modules together.", ActionUrl = Url.Action("Create"), ActionText = "Add course" }' />

<div class="panel">
    <partial name="_ListSearch" model="Model" />
    @if (Model.Items.Any())
    {
        <div class="table-scroll">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Name</th>
                        <th scope="col">Modules</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium font-monospace">@c.Code</td>
                            <td>@c.Name</td>
                            <td>@c.Modules.Count</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Enrol" asp-route-id="@c.CourseId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Enrol students" aria-label="Enrol students in @c.Code"><i class="bi bi-person-plus" aria-hidden="true"></i></a>
                                    <a asp-action="Modules" asp-route-id="@c.CourseId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Add or remove modules" aria-label="Add or remove modules in @c.Code"><i class="bi bi-journal-plus" aria-hidden="true"></i></a>
                                    <a asp-action="Details" asp-route-id="@c.CourseId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="View modules" aria-label="View modules in @c.Code"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a asp-action="Edit" asp-route-id="@c.CourseId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Edit" aria-label="Edit @c.Code"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <form asp-action="Delete" asp-route-id="@c.CourseId" method="post" data-confirm="Delete @c.Code? Its modules stay, but won't belong to a course any more.">
                                        <button type="submit" class="btn btn-icon btn-icon-danger" data-bs-toggle="tooltip" data-bs-title="Delete" aria-label="Delete @c.Code"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model" />
    }
    else if (!string.IsNullOrEmpty(Model.Query))
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-search", Title = "No courses match that search", Message = "Try a course code such as ADAD0701." }' />
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-collection", Title = "No courses yet", Message = "Add a course, then set it on each of its modules.", ActionUrl = Url.Action("Create"), ActionText = "Add course" }' />
    }
</div>
