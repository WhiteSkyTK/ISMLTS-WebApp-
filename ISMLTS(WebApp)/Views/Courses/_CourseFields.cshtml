@model Course

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="mb-3">
    <label asp-for="Code" class="form-label"></label>
    <input asp-for="Code" class="form-control font-monospace" placeholder="ADAD0701" autocomplete="off" />
    <span asp-validation-for="Code" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="Advanced Diploma in Application Development" autocomplete="off" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
