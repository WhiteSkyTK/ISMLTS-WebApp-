
@model GradebookViewModel
@using ISMLTS_WebApp_.Services
@{
    ViewData["Title"] = "Gradebook";
    ViewData["FilterLabel"] = "Find a student";
    ViewData["TableFacets"] = new List<TableFacet>
    {
        new()
        {
            Name = "state",
            Label = "Show students",
            AllText = "All students",
            Options = new() { ("unmarked", "Not marked yet"), ("marked", "Marked"), ("handed-in", "Handed in"), ("not-handed-in", "Not handed in") }
        }
    };
    var subtitle = $"{Model.ModuleCode} · out of {MarkRules.Format(Model.OutOf)}";
    var markedCount = Model.Rows.Count(r => r.HasMark);
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = $"{Model.AssessmentName} gradebook", Subtitle = subtitle, BackUrl = Url.Action("ForModule", "Assessments", new { moduleId = Model.ModuleId }), BackText = "Assessments", ActionUrl = Url.Action("Import", new { id = Model.AssessmentId }), ActionText = "Import from CSV", ActionIcon = "bi-upload" }' />

@* Outside the gradebook form: the release button is a form of its own *@
<div class="panel release-strip">
    <div>
        @if (Model.Released)
        {
            <span class="badge text-bg-success">Released</span>
            <span class="small">Students can see these marks. New marks show up for them as soon as you save.</span>
        }
        else
        {
            <span class="badge text-bg-warning">Hidden</span>
            <span class="small">Students can't see these marks until you release them. @markedCount of @Model.Rows.Count marked so far.</span>
        }
    </div>
    <div class="release-card-actions">
        <partial name="_ReleaseButton" model='new ReleaseButtonModel { AssessmentId = Model.AssessmentId, AssessmentName = Model.AssessmentName, Released = Model.Released, MarkedCount = markedCount, ReturnUrl = Url.Action("Gradebook", new { id = Model.AssessmentId }) }' />
        <a asp-controller="Marks" asp-action="ForModule" asp-route-moduleId="@Model.ModuleId" class="btn btn-sm btn-outline-rosebank"><i class="bi bi-grid-3x3" aria-hidden="true"></i> Markbook</a>
    </div>
</div>

<form asp-action="Gradebook" asp-route-id="@Model.AssessmentId" method="post">
    <div class="panel">
        @if (Model.Rows.Any())
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger small" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Nothing was saved. Fix the rows marked in red, then save again.</div>
            }
            <partial name="_TableFilter" model='"#gradebookTable"' />
            <div class="table-scroll">
                <table id="gradebookTable" class="table align-middle mb-0" data-sortable>
                    <thead>
                        <tr>
                            <th scope="col" data-sort="text" aria-sort="ascending">Student</th>
                            <th scope="col" data-sort="text">Submission</th>
                            <th scope="col">Score</th>
                            <th scope="col">Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            <tr data-state="@(row.HasMark ? "marked" : "unmarked") @(row.SubmissionStatus == "Not Submitted" ? "not-handed-in" : "handed-in")">
                                <td class="fw-medium" data-sort-value="@row.FullName">
                                    <input type="hidden" asp-for="Rows[i].StudentId" />
                                    @row.FullName
                                    @if (row.HasMark)
                                    {
                                        <span class="table-row-sub">Marked</span>
                                    }
                                </td>
                                <td>
                                    <partial name="~/Views/Assessments/_SubmissionStatus.cshtml" model="row.SubmissionStatus" />
                                    @if (row.File != null)
                                    {
                                        <span class="table-row-sub"><partial name="_FileLink" model="row.File" /></span>
                                    }
                                    @if (row.Link != null)
                                    {
                                        <a href="@row.Link" target="_blank" rel="noopener noreferrer" class="table-row-sub">Open work <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                    }
                                </td>
                                <td class="gradebook-score">
                                    <label asp-for="Rows[i].Score" class="visually-hidden">Score for @row.FullName</label>
                                    <div class="input-group input-group-sm">
                                        <input asp-for="Rows[i].Score" class="form-control" type="number" step="0.5" min="0" max="@MarkRules.Format(Model.OutOf)" />
                                        <span class="input-group-text">/ @MarkRules.Format(Model.OutOf)</span>
                                    </div>
                                    <span asp-validation-for="Rows[i].Score" class="text-danger small"></span>
                                </td>
                                <td>
                                    <label asp-for="Rows[i].Feedback" class="visually-hidden">Feedback for @row.FullName</label>
                                    <textarea asp-for="Rows[i].Feedback" class="form-control form-control-sm" rows="1" maxlength="1000"></textarea>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2 mb-0" data-filter-empty hidden>No students match that name.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Save all marks</button>
                <span class="form-text align-self-center">Leave a score blank to skip that student.</span>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-people", Title = "Nobody is enrolled in this module yet", Message = "An admin enrols students under Courses or Modules." }' />
        }
    </div>
</form>
