@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (User.IsInRole("Admin"))
{
    <partial name="_PageHeader" model='new PageHeaderModel { Title = "Dashboard", Subtitle = "Accounts, modules and courses at a glance." }' />
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-card"><i class="bi bi-people-fill" aria-hidden="true"></i><div><h2 class="h3">@Model.TotalStudents</h2><span>Students</span></div></div></div>
        <div class="col-md-4"><div class="stat-card"><i class="bi bi-person-workspace" aria-hidden="true"></i><div><h2 class="h3">@Model.TotalLecturers</h2><span>Lecturers</span></div></div></div>
        <div class="col-md-4"><div class="stat-card"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i><div><h2 class="h3">@Model.TotalModules</h2><span>Modules</span></div></div></div>
    </div>
    <div class="quick-actions">
        <a asp-controller="Students" asp-action="Index" class="quick-action-btn"><i class="bi bi-people" aria-hidden="true"></i><span>Manage students</span></a>
        <a asp-controller="Lecturers" asp-action="Index" class="quick-action-btn"><i class="bi bi-person-badge" aria-hidden="true"></i><span>Manage lecturers</span></a>
        <a asp-controller="Modules" asp-action="Index" class="quick-action-btn"><i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Manage modules</span></a>
        <a asp-controller="Courses" asp-action="Index" class="quick-action-btn"><i class="bi bi-collection" aria-hidden="true"></i><span>Manage courses</span></a>
        <a asp-controller="Admins" asp-action="Index" class="quick-action-btn"><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Manage admins</span></a>
        <a asp-controller="Announcements" asp-action="Create" class="quick-action-btn"><i class="bi bi-megaphone" aria-hidden="true"></i><span>Post announcement</span></a>
    </div>
    <div class="mt-4">
        <partial name="_DashboardAnnouncements" model="Model.Announcements" />
    </div>
}

@if (User.IsInRole("Lecturer"))
{
    <partial name="_PageHeader" model='new PageHeaderModel { Title = "Dashboard", Subtitle = "Your modules, registers and marks." }' />
    <div class="quick-actions mb-4">
        <a asp-controller="Attendance" asp-action="Index" class="quick-action-btn"><i class="bi bi-qr-code-scan" aria-hidden="true"></i><span>Take a register</span></a>
        <a asp-controller="Marks" asp-action="Index" class="quick-action-btn"><i class="bi bi-clipboard-check" aria-hidden="true"></i><span>Capture marks</span></a>
        <a asp-controller="Grading" asp-action="QuickEval" class="quick-action-btn"><i class="bi bi-clipboard-data" aria-hidden="true"></i><span>Quick Eval</span></a>
        <a asp-controller="Insights" asp-action="Class" class="quick-action-btn"><i class="bi bi-graph-up" aria-hidden="true"></i><span>Class insights</span></a>
        <a asp-controller="Tickets" asp-action="Index" class="quick-action-btn"><i class="bi bi-chat-dots" aria-hidden="true"></i><span>Answer tickets</span></a>
        <a asp-controller="Announcements" asp-action="Create" class="quick-action-btn"><i class="bi bi-megaphone" aria-hidden="true"></i><span>New announcement</span></a>
    </div>
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="panel h-100">
                <h5><i class="bi bi-calendar-event" aria-hidden="true"></i> Upcoming due dates you have set</h5>
                @if (Model.UpcomingTasks.Any())
                {
                    <ul class="mb-0">
                        @foreach (var t in Model.UpcomingTasks)
                        {
                            <li><span class="badge task-badge task-@t.Type.ToLowerInvariant()">@t.Type</span> @t.Title — @t.DueDate.ToString("ddd, dd MMM")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Nothing due soon. Add assessments under Assessments.</p>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <partial name="_DashboardAnnouncements" model="Model.Announcements" />
        </div>
    </div>
}

@if (User.IsInRole("Student"))
{
    <div class="hero-banner mb-4 position-relative">
        <h1>Welcome to Rosebank International</h1>
        <button id="listenBtn" class="btn btn-sm listen-btn" type="button"><i class="bi bi-volume-up-fill" aria-hidden="true"></i> Listen</button>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel mb-3">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation"><button class="nav-link active" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabAnnouncements" aria-controls="tabAnnouncements" aria-selected="true">Announcements</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#tabWorkToDo" aria-controls="tabWorkToDo" aria-selected="false">Work to do</button></li>
                </ul>
                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="tabAnnouncements" role="tabpanel">
                        @if (!Model.Announcements.Any())
                        {
                            <p class="text-muted mb-0">There are no announcements to display.</p>
                        }
                        else
                        {
                            @foreach (var a in Model.Announcements)
                            {
                                <partial name="_AnnouncementItem" model="a" />
                            }
                            <a asp-controller="Announcements" asp-action="Index" class="small d-inline-block mt-2">All announcements <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                    <div class="tab-pane fade" id="tabWorkToDo" role="tabpanel">
                        @if (Model.UpcomingTasks.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var t in Model.UpcomingTasks)
                                {
                                    <li><span class="badge task-badge task-@t.Type.ToLowerInvariant()">@t.Type</span> @t.Title — due @t.DueDate.ToString("ddd, dd MMM")</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Nothing due soon.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h5 class="mb-0">My modules</h5>
                    <ul class="nav nav-pills nav-pills-sm">
                        <li class="nav-item"><button class="nav-link active course-filter" type="button" data-filter="all">All</button></li>
                        <li class="nav-item"><button class="nav-link course-filter" type="button" data-filter="pinned">Pinned</button></li>
                        <li class="nav-item"><button class="nav-link course-filter" type="button" data-filter="archived">Archived</button></li>
                    </ul>
                </div>
                <div class="row g-3">
                    @foreach (var c in Model.Courses)
                    {
                        <div class="col-md-6 course-card-wrap cat-all @(c.IsCurrentSemester ? "" : "cat-archived")">
                            <div class="course-card">
                                <div class="d-flex justify-content-between">
                                    <strong class="font-monospace">@c.Code</strong>
                                    <button class="pin-btn" type="button" aria-label="Pin @c.Code" aria-pressed="false"><i class="bi bi-pin-angle" aria-hidden="true"></i></button>
                                </div>
                                <div class="mb-2">@c.Name</div>
                                <a asp-controller="Assessments" asp-action="MyAssessments" class="small">Assessments <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </div>
                    }
                    @if (!Model.Courses.Any())
                    {
                        <p class="text-muted mb-0">You are not enrolled in any modules yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel">
                <h5><i class="bi bi-calendar-event" aria-hidden="true"></i> Calendar</h5>
                <p class="fw-semibold">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
                <hr />
                <h6 class="text-muted">Upcoming</h6>
                @foreach (var t in Model.UpcomingTasks.OrderBy(t => t.DueDate))
                {
                    <div class="d-flex justify-content-between small mb-2">
                        <span><span class="badge task-badge task-@t.Type.ToLowerInvariant()">@t.Type</span> @t.Title</span>
                        <span class="text-muted">@t.DueDate.ToString("dd MMM")</span>
                    </div>
                }
                @if (!Model.UpcomingTasks.Any())
                {
                    <p class="small text-muted mb-0">Nothing due soon.</p>
                }
            </div>
        </div>
    </div>
}
