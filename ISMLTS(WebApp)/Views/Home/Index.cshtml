@model ISMLTS_WebApp_.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="hero-banner mb-4">
    <h1>Welcome, @User.Identity?.Name</h1>
    <p class="mb-0">ISMLTS — IIE Rosebank College</p>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-people-fill"></i>
                <div><h3>@Model.TotalStudents</h3><span>Students</span></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-person-workspace"></i>
                <div><h3>@Model.TotalLecturers</h3><span>Lecturers</span></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-journal-bookmark-fill"></i>
                <div><h3>@Model.TotalModules</h3><span>Modules</span></div>
            </div>
        </div>
    </div>

    <div class="quick-actions">
        <a asp-controller="Students" asp-action="Index" class="quick-action-btn"><i class="bi bi-people"></i><span>Manage Students</span></a>
        <a asp-controller="Lecturers" asp-action="Index" class="quick-action-btn"><i class="bi bi-person-badge"></i><span>Manage Lecturers</span></a>
        <a asp-controller="Modules" asp-action="Index" class="quick-action-btn"><i class="bi bi-journal-bookmark"></i><span>Manage Modules</span></a>
    </div>
}

@if (User.IsInRole("Lecturer"))
{
    <div class="quick-actions mb-4">
        <a asp-controller="Announcements" asp-action="Create" class="quick-action-btn"><i class="bi bi-megaphone"></i><span>New Announcement</span></a>
        <a asp-controller="Attendance" asp-action="Index" class="quick-action-btn"><i class="bi bi-qr-code-scan"></i><span>Mark Register</span></a>
        <a asp-controller="Marks" asp-action="Index" class="quick-action-btn"><i class="bi bi-clipboard-check"></i><span>Capture Marks</span></a>
    </div>
    <div class="panel">
        <h5><i class="bi bi-calendar-event"></i> Upcoming Due Dates You've Set</h5>
        <ul>@foreach (var due in Model.UpcomingDueDates) {
        <li>@due</li>
    }
</ul>
</div>
}

@if (User.IsInRole("Student"))
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="panel">
                <h5><i class="bi bi-megaphone"></i> Announcements</h5>
                <ul>@foreach (var a in Model.Announcements) {
                <li>@a</li>
            }
</ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel">
            <h5><i class="bi bi-calendar-event"></i> Due Soon</h5>
            <ul>@foreach (var due in Model.UpcomingDueDates) {
            <li>@due</li>
                        }
</ul>
        </div>
    </div>
    <div class="col-12">
        <a asp-controller="Attendance" asp-action="Scan" class="quick-action-btn d-inline-flex"><i class="bi bi-qr-code-scan"></i><span>Scan Attendance QR</span></a>
    </div>
</div>
}