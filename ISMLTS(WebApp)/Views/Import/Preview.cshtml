@model UserImportViewModel
@using ISMLTS_WebApp_.Services
@{
    ViewData["Title"] = "Check Import";
    var result = Model.Result!;
    var problems = result.Rows.Count - result.ValidCount;
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Check the import", Subtitle = $"New {Model.Noun}", BackUrl = Url.Action("Index", new { kind = Model.Kind }), BackText = "Choose another file" }' />

<div class="panel">
    @if (result.FileError != null)
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-file-earmark-x", Title = "This file can not be imported", Message = result.FileError, ActionUrl = Url.Action("Index", new { kind = Model.Kind }), ActionText = "Try another file" }' />
    }
    else
    {
        <div class="stat-inline">
            <div><strong>@result.ValidCount</strong><span class="small text-muted">ready to add</span></div>
            <div><strong>@problems</strong><span class="small text-muted">with problems (skipped)</span></div>
        </div>
        <div class="table-scroll">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Row</th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        @if (Model.IsStudents)
                        {
                            <th scope="col">Programme</th>
                        }
                        <th scope="col">Check</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in result.Rows)
                    {
                        <tr class="@(row.IsValid ? null : "table-danger")">
                            <td>@row.Line</td>
                            <td>@row.Name</td>
                            <td>@row.Email</td>
                            @if (Model.IsStudents)
                            {
                                <td>@(row.Programme ?? "—")</td>
                            }
                            <td>
                                @if (row.IsValid)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> OK</span>
                                }
                                else
                                {
                                    <span class="text-danger small"><i class="bi bi-x-circle" aria-hidden="true"></i> @row.Error</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <form asp-action="Confirm" method="post" class="mt-3">
            <input type="hidden" name="kind" value="@Model.Kind" />
            <label for="csv" class="visually-hidden">File contents</label>
            <textarea id="csv" name="csv" hidden>@Model.Csv</textarea>
            @if (Model.IsStudents && result.ValidCount > 0)
            {
                <div class="row g-3 form-panel">
                    <div class="col-sm-7">
                        <label for="courseId" class="form-label">Enrol them in a course (optional)</label>
                        <select id="courseId" name="courseId" class="form-select">
                            <option value="">Don't enrol them yet</option>
                            @foreach (var course in courses)
                            {
                                <option value="@course.CourseId">@course.Code - @course.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-5">
                        <label for="term" class="form-label">Modules</label>
                        <select id="term" name="term" class="form-select">
                            <option value="@CourseTerms.All">Every module</option>
                            <option value="@CourseTerms.Term1">Term 1 only</option>
                            <option value="@CourseTerms.Term2">Term 2 only</option>
                        </select>
                    </div>
                </div>
            }
            <div class="form-actions">
                @if (result.ValidCount > 0)
                {
                    <button type="submit" class="btn btn-rosebank" data-loading="Adding…"><i class="bi bi-person-plus" aria-hidden="true"></i> Add @result.ValidCount @(result.ValidCount == 1 ? Model.Noun.TrimEnd('s') : Model.Noun)</button>
                }
                <a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Choose another file</a>
            </div>
        </form>
    }
</div>
