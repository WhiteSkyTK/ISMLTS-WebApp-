@model MarkForm
@{
    ViewData["Title"] = "Add Mark";
    string subtitle = $"{ViewBag.StudentName} · {ViewBag.ModuleDisplay}";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Add mark", Subtitle = subtitle, BackUrl = Url.Action("ForModule", new { moduleId = Model.ModuleId }), BackText = "Module marks" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_MarkFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Save mark</button>
            <a asp-action="ForModule" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
