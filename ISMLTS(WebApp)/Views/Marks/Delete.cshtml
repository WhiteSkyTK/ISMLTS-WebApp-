@model ISMLTS_WebApp_.Models.Mark
@{
    ViewData["Title"] = "Delete Mark";
}

<h1>Delete Mark</h1>
<h3>Are you sure you want to delete this?</h3>
<dl class="row">
    <dt class="col-sm-2">Student</dt>
    <dd class="col-sm-10">@Model.Student?.FullName</dd>
    <dt class="col-sm-2">Assessment</dt>
    <dd class="col-sm-10">@Model.AssessmentName</dd>
    <dt class="col-sm-2">Score</dt>
    <dd class="col-sm-10">@Model.Score / @Model.MaxScore</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="MarkId" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="ForModule" asp-route-moduleId="@Model.ModuleId">Back</a>
</form>