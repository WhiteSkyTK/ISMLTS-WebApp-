@model Mark
@{
    ViewData["Title"] = "Edit Mark";
    var subtitle = $"{Model.Student?.FullName} · {Model.Module?.Code}";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Edit mark", Subtitle = subtitle, BackUrl = Url.Action("ForModule", new { moduleId = Model.ModuleId }), BackText = "Module marks" }' />

<div class="panel form-panel">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MarkId" />
        <partial name="_MarkFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
            <a asp-action="ForModule" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
