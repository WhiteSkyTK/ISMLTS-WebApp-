@model ModuleMarksViewModel
@{
    ViewData["Title"] = "Marks";
    ViewData["FilterLabel"] = "Find a student";
    var atRisk = Model.Rows.Count(r => r.Marks.Any() && r.IsAtRisk);
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Marks", Subtitle = Model.ModuleDisplay, BackUrl = Url.Action("Index"), BackText = "All modules" }' />

<div class="panel">
    @if (Model.Rows.Any())
    {
        <div class="stat-inline">
            <div><strong>@Model.Rows.Count</strong><span class="small text-muted">students</span></div>
            <div><strong>@atRisk</strong><span class="small text-muted">at risk (average below 50%)</span></div>
        </div>
        <partial name="_TableFilter" model='"#marksTable"' />
        <div class="table-scroll">
            <table id="marksTable" class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Marks</th>
                        <th scope="col">Average</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.OrderBy(r => r.FullName))
                    {
                        <tr>
                            <td class="fw-medium">@row.FullName</td>
                            <td>
                                @if (!row.Marks.Any())
                                {
                                    <span class="text-muted small">No marks yet</span>
                                }
                                @foreach (var m in row.Marks.OrderBy(m => m.DateCaptured))
                                {
                                    <div class="mark-line">
                                        <span>@m.AssessmentName: <strong>@m.Score/@m.MaxScore</strong> <span class="text-muted">(@m.Percentage%)</span></span>
                                        <a asp-action="Edit" asp-route-id="@m.MarkId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Edit mark" aria-label="Edit the @m.AssessmentName mark for @row.FullName"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                        <form asp-action="Delete" asp-route-id="@m.MarkId" method="post" data-confirm="Delete the @m.AssessmentName mark for @row.FullName?">
                                            <button type="submit" class="btn btn-icon btn-icon-danger" data-bs-toggle="tooltip" data-bs-title="Delete mark" aria-label="Delete the @m.AssessmentName mark for @row.FullName"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                }
                            </td>
                            <td>@(row.Marks.Any() ? $"{row.AveragePercentage}%" : "—")</td>
                            <td>
                                @if (!row.Marks.Any())
                                {
                                    <span class="badge text-bg-secondary">No data</span>
                                }
                                else if (row.IsAtRisk)
                                {
                                    <span class="badge text-bg-danger">At risk</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">On track</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Create" asp-route-moduleId="@Model.ModuleId" asp-route-studentId="@row.StudentId" class="btn btn-outline-rosebank btn-sm text-nowrap"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add mark</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0" data-filter-empty hidden>No students match that name.</p>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-people", Title = "Nobody is enrolled in this module yet", Message = "An admin enrols students under Modules." }' />
    }
</div>
