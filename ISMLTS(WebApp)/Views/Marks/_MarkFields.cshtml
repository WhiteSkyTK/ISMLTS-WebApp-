@model Mark

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input type="hidden" asp-for="StudentId" />
<input type="hidden" asp-for="ModuleId" />
<div class="mb-3">
    <label asp-for="AssessmentName" class="form-label"></label>
    <input asp-for="AssessmentName" class="form-control" placeholder="e.g. ICE Task 1, Quiz 2, POE" autocomplete="off" />
    <span asp-validation-for="AssessmentName" class="text-danger small"></span>
</div>
<div class="row g-3 mb-3">
    <div class="col-6">
        <label asp-for="Score" class="form-label"></label>
        <input asp-for="Score" class="form-control" type="number" step="0.5" min="0" />
        <span asp-validation-for="Score" class="text-danger small"></span>
    </div>
    <div class="col-6">
        <label asp-for="MaxScore" class="form-label"></label>
        <input asp-for="MaxScore" class="form-control" type="number" step="0.5" min="0.5" />
        <span asp-validation-for="MaxScore" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="DateCaptured" class="form-label"></label>
    <input asp-for="DateCaptured" class="form-control" type="date" />
    <span asp-validation-for="DateCaptured" class="text-danger small"></span>
</div>
