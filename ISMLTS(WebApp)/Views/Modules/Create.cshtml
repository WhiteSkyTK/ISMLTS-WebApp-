@model Module
@{
    ViewData["Title"] = "Add Module";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Add module", Subtitle = "You can enrol students straight after saving.", BackUrl = Url.Action("Index"), BackText = "Modules" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_ModuleFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Add module</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
