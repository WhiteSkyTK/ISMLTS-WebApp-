@model ISMLTS_WebApp_.Models.Module
@{
    ViewData["Title"] = "Module Details";
}

<h1>Module Details</h1>
<dl class="row">
    <dt class="col-sm-2">Code</dt>
    <dd class="col-sm-10">@Model.Code</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Lecturer</dt>
    <dd class="col-sm-10">@(Model.Lecturer?.FullName ?? "—")</dd>
    <dt class="col-sm-2">Enrolled</dt>
    <dd class="col-sm-10">@Model.Students.Count() student(s)</dd>
</dl>
<a asp-action="Enrol" asp-route-id="@Model.ModuleId">Enrol Students</a> |
<a asp-action="Edit" asp-route-id="@Model.ModuleId">Edit</a> |
<a asp-action="Index">Back to List</a>