@model Module
@{
    ViewData["Title"] = "Module Details";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.Code, Subtitle = Model.Name, BackUrl = Url.Action("Index"), BackText = "Modules", ActionUrl = Url.Action("Enrol", new { id = Model.ModuleId }), ActionText = "Enrol students", ActionIcon = "bi-person-plus" }' />

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel">
            <dl class="row detail-list mb-0">
                <dt class="col-sm-5">Lecturer</dt>
                <dd class="col-sm-7">@(Model.Lecturer?.FullName ?? "—")</dd>
                <dt class="col-sm-5">Term</dt>
                <dd class="col-sm-7">@(Model.Term == "Term2" ? "Term 2" : "Term 1")</dd>
                <dt class="col-sm-5">Course</dt>
                <dd class="col-sm-7 mb-0">@(Model.Course != null ? $"{Model.Course.Code} - {Model.Course.Name}" : "Not in a course")</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.ModuleId" class="btn btn-outline-rosebank btn-sm mt-3"><i class="bi bi-pencil" aria-hidden="true"></i> Edit module</a>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel">
            <h2 class="h5"><i class="bi bi-people" aria-hidden="true"></i> Enrolled students (@Model.Students.Count)</h2>
            @if (Model.Students.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var s in Model.Students.OrderBy(s => s.FullName))
                    {
                        <li class="py-1 border-bottom">@s.FullName <span class="table-row-sub d-inline ms-1">@s.Email</span></li>
                    }
                </ul>
            }
            else
            {
                <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-person-plus", Title = "Nobody is enrolled yet", ActionUrl = Url.Action("Enrol", new { id = Model.ModuleId }), ActionText = "Enrol students" }' />
            }
        </div>
    </div>
</div>
