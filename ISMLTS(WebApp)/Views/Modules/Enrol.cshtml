@model EnrolmentViewModel
@{
    ViewData["Title"] = "Enrol Students";
    ViewData["FilterLabel"] = "Find a student";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Enrol students", Subtitle = Model.ModuleName, BackUrl = Url.Action("Index"), BackText = "Modules" }' />

<div class="alert alert-info small form-panel" role="note"><i class="bi bi-lightbulb" aria-hidden="true"></i> Enrolling a whole class? Use <strong>Courses → Enrol students</strong> to put them in every module of the course at once. This page is for one-off changes.</div>

<form asp-action="Enrol" asp-route-id="@Model.ModuleId" method="post">
    <div class="panel form-panel">
        @if (Model.Students.Any())
        {
            <partial name="_TableFilter" model='"#enrolList"' />
            <fieldset id="enrolList">
                <legend class="form-label">Tick everyone who takes this module</legend>
                @for (var i = 0; i < Model.Students.Count; i++)
                {
                    <div class="form-check py-1" data-filter-item>
                        <input class="form-check-input" type="checkbox"
                               name="selectedStudentIds" value="@Model.Students[i].StudentId"
                               id="student_@Model.Students[i].StudentId"
                               checked="@Model.Students[i].IsEnrolled" />
                        <label class="form-check-label" for="student_@Model.Students[i].StudentId">@Model.Students[i].FullName</label>
                    </div>
                }
            </fieldset>
            <p class="text-muted small mb-0" data-filter-empty hidden>No students match that name.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-check-lg" aria-hidden="true"></i> Save enrolment</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-people", Title = "No students exist yet", Message = "Add students first, then come back to enrol them.", ActionUrl = Url.Action("Create", "Students"), ActionText = "Add student" }' />
        }
    </div>
</form>
