@model PagedList<Module>
@{
    ViewData["Title"] = "Modules";
    ViewData["SearchLabel"] = "Search by code, name or lecturer";
    var searching = !string.IsNullOrEmpty(Model.Query) || (ViewData["ListFilters"] as List<ListFilter>)?.Exists(f => !string.IsNullOrEmpty(f.Selected)) == true;
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Modules", Subtitle = "Each module has one lecturer and the students enrolled in it.", ActionUrl = Url.Action("Create"), ActionText = "Add module" }' />

<div class="panel">
    <partial name="_ListSearch" model="Model" />
    @if (Model.Items.Any())
    {
        <div class="table-scroll">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <partial name="_SortHeader" model='new SortHeaderModel { Label = "Code", Key = "code", Current = Model.Sort }' />
                        <partial name="_SortHeader" model='new SortHeaderModel { Label = "Name", Key = "name", Current = Model.Sort }' />
                        <partial name="_SortHeader" model='new SortHeaderModel { Label = "Lecturer", Key = "lecturer", Current = Model.Sort }' />
                        <partial name="_SortHeader" model='new SortHeaderModel { Label = "Term", Key = "term", Current = Model.Sort }' />
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium font-monospace">@m.Code</td>
                            <td>
                                @m.Name
                                @if (m.Course != null)
                                {
                                    <span class="table-row-sub">@m.Course.Code</span>
                                }
                            </td>
                            <td>@(m.Lecturer?.FullName ?? "—")</td>
                            <td>@(m.Term == "Term2" ? "Term 2" : "Term 1")</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Enrol" asp-route-id="@m.ModuleId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Enrol students"><i class="bi bi-person-plus" aria-hidden="true"></i><span class="visually-hidden">Enrol students in @m.Code</span></a>
                                    <a asp-action="Details" asp-route-id="@m.ModuleId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="View"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">View @m.Code</span></a>
                                    <a asp-action="Edit" asp-route-id="@m.ModuleId" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden">Edit @m.Code</span></a>
                                    <form asp-action="Delete" asp-route-id="@m.ModuleId" method="post" data-confirm="Delete @m.Code? Its marks, assessments, submissions, tickets and attendance are deleted too.">
                                        <button type="submit" class="btn btn-icon btn-icon-danger" data-bs-toggle="tooltip" data-bs-title="Delete" aria-label="Delete @m.Code"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model" />
    }
    else if (searching)
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-search", Title = "No modules match", Message = "Try a module code such as XADAD7112 or a lecturer name, or clear the filters." }' />
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-journal-bookmark", Title = "No modules yet", Message = "Add a module and give it a lecturer, then enrol students.", ActionUrl = Url.Action("Create"), ActionText = "Add module" }' />
    }
</div>
