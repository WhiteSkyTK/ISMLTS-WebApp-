@model IEnumerable<ISMLTS_WebApp_.Models.Module>
@{
    ViewData["Title"] = "Modules";
}

<h1>Modules</h1>
<p><a asp-action="Create" class="btn btn-rosebank">+ Add Module</a></p>
<table class="table">
    <thead>
        <tr><th>Code</th><th>Name</th><th>Lecturer</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@(item.Lecturer?.FullName ?? "—")</td>
                <td>
                    <a asp-action="Enrol" asp-route-id="@item.ModuleId">Enrol Students</a> |
                    <a asp-action="Edit" asp-route-id="@item.ModuleId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ModuleId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ModuleId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>