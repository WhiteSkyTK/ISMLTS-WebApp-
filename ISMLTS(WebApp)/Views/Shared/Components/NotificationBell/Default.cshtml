@model NotificationBellViewModel
@using ISMLTS_WebApp_.Services
@{
    var unreadShown = Model.Latest.Where(n => !n.IsRead).ToList();
    var label = Model.UnreadCount == 0 ? "Notifications" : $"Notifications, {Model.UnreadCount} unread";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="@label" data-notification-bell>
    <i class="bi bi-bell-fill fs-5" aria-hidden="true"></i>
    @if (Model.UnreadCount > 0)
    {
        <span class="notif-badge" data-notification-count>@(Model.UnreadCount > 9 ? "9+" : Model.UnreadCount.ToString())</span>
    }
</a>
<div class="dropdown-menu dropdown-menu-end notif-dropdown p-0">
    <div class="notif-header">
        <span class="fw-semibold">Notifications</span>
        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-link btn-sm p-0">Mark all read</button>
            </form>
        }
    </div>

    @if (unreadShown.Any())
    {
        @* site.js posts this when the menu opens, so what you've seen stops counting as new *@
        <form asp-controller="Notifications" asp-action="MarkRead" method="post" data-mark-seen hidden>
            @foreach (var n in unreadShown)
            {
                <input type="hidden" name="ids" value="@n.NotificationId" />
            }
        </form>
    }

    <div class="notif-list">
        @foreach (var n in Model.Latest)
        {
            <form asp-controller="Notifications" asp-action="Open" asp-route-id="@n.NotificationId" method="post">
                <button type="submit" class="notif-item @(n.IsRead ? null : "is-unread")">
                    <span class="notif-title">@n.Title</span>
                    @if (!string.IsNullOrEmpty(n.Message))
                    {
                        <span class="notif-message">@n.Message</span>
                    }
                    <span class="notif-time">@TimeAgo.Describe(n.CreatedAt, DateTime.UtcNow)</span>
                </button>
            </form>
        }
        @if (!Model.Latest.Any())
        {
            <p class="notif-empty"><i class="bi bi-check2-circle" aria-hidden="true"></i> You're all caught up.</p>
        }
    </div>

    @if (Model.DueSoon.Any())
    {
        <div class="notif-section">
            <h2 class="notif-section-title">Due soon</h2>
            @foreach (var item in Model.DueSoon)
            {
                <p class="small mb-1">@item</p>
            }
        </div>
    }

    <a asp-controller="Notifications" asp-action="Index" class="notif-footer">View all notifications</a>
</div>
