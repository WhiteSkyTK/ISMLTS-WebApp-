@model ErrorViewModel
@using ISMLTS_WebApp_.Services
@{
    ViewData["Title"] = "Error";
}

<partial name="_StatusMessage" model="StatusPages.Describe(500)" />
@if (Model.ShowRequestId)
{
    <p class="text-center small text-muted">If this keeps happening, give this reference to the admin office: <code>@Model.RequestId</code></p>
}
