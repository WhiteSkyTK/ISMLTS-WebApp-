@using Microsoft.Extensions.Options
@using ISMLTS_WebApp_.Services
@inject IOptions<ExternalLinksOptions> ExternalLinks
@{
    // Shortcuts per role. Site pages link straight through; college sites open in a new tab and are left out
    // while ExternalLinks has no address for them.
    var library = ExternalLinksOptions.Usable(ExternalLinks.Value.IieLibrary);
    var portal = ExternalLinksOptions.Usable(ExternalLinks.Value.StudentPortal);
    var items = new List<(string Icon, string Label, string? Controller, string? Action, string? Url)>();
    if (User.IsInRole(Roles.Student))
    {
        items.Add(("bi-qr-code-scan", "Scan In", "Attendance", "Scan", null));
        items.Add(("bi-journal-check", "Work To Do", "Assessments", "MyAssessments", null));
        items.Add(("bi-megaphone", "Announcements", "Announcements", "Index", null));
        items.Add(("bi-graph-up", "My Progress", "Insights", "MyProgress", null));
        items.Add(("bi-trophy", "Awards", "Awards", "Index", null));
        items.Add(("bi-folder2-open", "Portfolio", "Portfolio", "Index", null));
        if (library != null) items.Add(("bi-book", "IIE Library", null, null, library));
        if (portal != null) items.Add(("bi-mortarboard", "Student Portal", null, null, portal));
    }
    else if (User.IsInRole(Roles.Lecturer))
    {
        items.Add(("bi-qr-code", "Take Register", "Attendance", "Index", null));
        items.Add(("bi-clipboard-check", "Capture Marks", "Marks", "Index", null));
        items.Add(("bi-megaphone", "Announcements", "Announcements", "Index", null));
        items.Add(("bi-clipboard-data", "Quick Eval", "Grading", "QuickEval", null));
        items.Add(("bi-graph-up", "Class Insights", "Insights", "Class", null));
        items.Add(("bi-clock", "Timetable", "Timetable", "Index", null));
        if (library != null) items.Add(("bi-book", "IIE Library", null, null, library));
    }
    else if (User.IsInRole(Roles.Admin))
    {
        items.Add(("bi-person-plus", "Add Student", "Students", "Create", null));
        items.Add(("bi-journal-plus", "Add Module", "Modules", "Create", null));
        items.Add(("bi-megaphone", "Announcements", "Announcements", "Index", null));
        items.Add(("bi-upload", "Bulk Import", "Import", "Index", null));
        items.Add(("bi-bar-chart", "Reports", "Reports", "Index", null));
        items.Add(("bi-calendar-range", "Terms", "Terms", "Index", null));
        items.Add(("bi-journal-text", "Audit Log", "Audit", "Index", null));
        items.Add(("bi-heart-pulse", "Site Check", "SiteCheck", "Index", null));
    }
    items.Add(("bi-calendar3", "Calendar", "Calendar", "Index", null));
    items.Add(("bi-question-circle", "Help", "Help", "Index", null));
}

<nav class="icon-nav-row" aria-label="Shortcuts">
    @foreach (var item in items)
    {
        if (item.Url != null)
        {
            <a class="icon-nav-item" href="@item.Url" target="_blank" rel="noopener noreferrer"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i></span><span class="visually-hidden"> (opens in a new tab)</span></a>
        }
        else
        {
            <a class="icon-nav-item" asp-controller="@item.Controller" asp-action="@item.Action"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span></a>
        }
    }
</nav>
