<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ISMLTS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var signedIn = User.Identity?.IsAuthenticated == true;
        var displayName = User.Identity?.Name ?? "";
        var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    }
    <a href="#main" class="visually-hidden-focusable skip-link">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-rosebank navbar-dark shadow-sm mb-0" aria-label="Main">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill" aria-hidden="true"></i> ISMLTS
                </a>

                @if (signedIn && User.IsInRole("Student"))
                {
                    @await Component.InvokeAsync("ModuleSwitcher")
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNav" class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index" highlight-active><i class="bi bi-people" aria-hidden="true"></i> Students</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Lecturers" asp-action="Index" highlight-active><i class="bi bi-person-badge" aria-hidden="true"></i> Lecturers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Index" highlight-active><i class="bi bi-journal-bookmark" aria-hidden="true"></i> Modules</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index" highlight-active><i class="bi bi-collection" aria-hidden="true"></i> Courses</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admins" asp-action="Index" highlight-active><i class="bi bi-shield-lock" aria-hidden="true"></i> Admins</a></li>
                        }
                        @if (User.IsInRole("Lecturer"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Marks" asp-action="Index" highlight-active><i class="bi bi-clipboard-check" aria-hidden="true"></i> Marks</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Assessments" asp-action="Index" highlight-active><i class="bi bi-journal-text" aria-hidden="true"></i> Assessments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Attendance" asp-action="Index" highlight-active><i class="bi bi-qr-code" aria-hidden="true"></i> Attendance</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tickets" asp-action="Index" highlight-active><i class="bi bi-chat-dots" aria-hidden="true"></i> Tickets</a></li>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Marks" asp-action="MyMarks" highlight-active><i class="bi bi-clipboard-check" aria-hidden="true"></i> My Marks</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Assessments" asp-action="MyAssessments" highlight-active><i class="bi bi-journal-text" aria-hidden="true"></i> My Assessments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tickets" asp-action="MyTickets" highlight-active><i class="bi bi-chat-dots" aria-hidden="true"></i> My Tickets</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Attendance" asp-action="MyAttendance" highlight-active><i class="bi bi-qr-code" aria-hidden="true"></i> My Attendance</a></li>
                        }
                    </ul>

                    @if (signedIn)
                    {
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item dropdown">
                                @await Component.InvokeAsync("NotificationBell")
                            </li>
                            <li class="nav-item dropdown ms-lg-2">
                                <button type="button" class="nav-link" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-initials" aria-hidden="true">@initials</span>
                                    <span class="visually-hidden">Account menu for @displayName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h2 class="dropdown-header">@displayName</h2></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person" aria-hidden="true"></i> Profile and security</a></li>
                                    @if (User.IsInRole("Student"))
                                    {
                                        <li><span class="dropdown-item disabled" aria-disabled="true"><i class="bi bi-folder2-open" aria-hidden="true"></i> My Portfolio <span class="badge text-bg-light ms-1">Soon</span></span></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell" aria-hidden="true"></i> Notifications</a></li>
                                    @if (User.IsInRole("Student") || User.IsInRole("Lecturer"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Settings"><i class="bi bi-sliders" aria-hidden="true"></i> Notification settings</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav"><li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in</a></li></ul>
                    }
                </div>
            </div>
        </nav>
        @if (signedIn)
        {
            <partial name="_IconNav" />
        }
    </header>

    <div class="@(ViewData["FullWidth"] is true ? null : "container mt-4")">
        <main id="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-center py-3 mt-4">
        <div class="container">&copy; @DateTime.Now.Year All Rights Reserved — ISMLTS, IIE Rosebank College</div>
    </footer>

    @if (TempData["Toast"] is string toast)
    {
        var toastType = TempData["ToastType"] as string ?? "success";
        var toastIcon = toastType switch { "danger" => "bi-exclamation-triangle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
        var closeClass = toastType == "info" ? "btn-close" : "btn-close btn-close-white";
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast align-items-center text-bg-@toastType border-0" aria-live="polite" aria-atomic="true" data-app-toast>
                <div class="d-flex">
                    <div class="toast-body"><i class="bi @toastIcon me-1" aria-hidden="true"></i> @toast</div>
                    <button type="button" class="@closeClass me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (signedIn)
    {
        <partial name="_ConfirmModal" />
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
