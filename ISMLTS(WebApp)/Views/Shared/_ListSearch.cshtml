@model IPagedList
@{
    var label = ViewData["SearchLabel"] as string ?? "Search";
}

@* Server-side search for the paged admin lists; submits with Enter *@
<form method="get" class="table-toolbar" role="search">
    <label for="q" class="visually-hidden">@label</label>
    <div class="input-group table-search">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input id="q" name="q" type="search" value="@Model.Query" class="form-control" placeholder="@label" />
        <button type="submit" class="btn btn-outline-rosebank">Search</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <a asp-route-q="" class="btn btn-link btn-sm">Clear search</a>
    }
</form>
