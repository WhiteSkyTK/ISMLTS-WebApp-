@model IPagedList
@using ISMLTS_WebApp_.Services

@if (Model.TotalCount > 0)
{
    <div class="pager-bar">
        <span class="small text-muted">Showing @Model.FirstItem–@Model.LastItem of @Model.TotalCount</span>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : null)">
                        <a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query" aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                    </li>
                    @foreach (var number in Pagination.Window(Model.Page, Model.TotalPages))
                    {
                        <li class="page-item @(number == Model.Page ? "active" : null)">
                            <a class="page-link" asp-route-page="@number" asp-route-q="@Model.Query" aria-current="@(number == Model.Page ? "page" : null)">@number</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query" aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
