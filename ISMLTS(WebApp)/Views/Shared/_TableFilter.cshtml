@model string
@{
    var label = ViewData["FilterLabel"] as string ?? "Filter this list";
    var inputId = $"filter-{Model.TrimStart('#')}";
}

@* Instant, in-page filtering; Model is the CSS selector of the table or list to filter *@
<div class="table-toolbar">
    <label for="@inputId" class="visually-hidden">@label</label>
    <div class="input-group table-search">
        <span class="input-group-text"><i class="bi bi-funnel" aria-hidden="true"></i></span>
        <input id="@inputId" type="search" class="form-control" placeholder="@label" data-table-filter="@Model" autocomplete="off" />
    </div>
</div>
