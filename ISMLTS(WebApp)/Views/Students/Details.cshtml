@model Student
@{
    ViewData["Title"] = "Student Details";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.FullName, Subtitle = "Student", BackUrl = Url.Action("Index"), BackText = "Students", ActionUrl = Url.Action("Edit", new { id = Model.StudentId }), ActionText = "Edit", ActionIcon = "bi-pencil" }' />

<div class="panel form-panel">
    <dl class="row detail-list mb-0">
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Programme</dt>
        <dd class="col-sm-8">@(Model.Programme ?? "Not set")</dd>
        <dt class="col-sm-4">Modules</dt>
        <dd class="col-sm-8 mb-0">
            @if (Model.Modules.Any())
            {
                @string.Join(", ", Model.Modules.OrderBy(m => m.Code).Select(m => m.Code))
            }
            else
            {
                <span class="text-muted">Not enrolled in any modules yet</span>
            }
        </dd>
    </dl>
</div>
