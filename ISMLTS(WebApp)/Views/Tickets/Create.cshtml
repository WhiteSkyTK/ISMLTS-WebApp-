@model Ticket
@{
    ViewData["Title"] = "Raise a Ticket";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Raise a ticket", Subtitle = "Your question goes to the lecturer of the module you pick.", BackUrl = Url.Action("MyTickets"), BackText = "My tickets" }' />

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="ModuleId" class="form-label"></label>
            <select asp-for="ModuleId" class="form-select" asp-items="@(new SelectList(ViewBag.Modules, "ModuleId", "Display"))">
                <option value="">Choose a module</option>
            </select>
            <span asp-validation-for="ModuleId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Subject" class="form-label"></label>
            <input asp-for="Subject" class="form-control" placeholder="e.g. Question about the POE brief" autocomplete="off" />
            <span asp-validation-for="Subject" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Your question</label>
            <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-rosebank" data-loading="Sending…"><i class="bi bi-send" aria-hidden="true"></i> Send ticket</button>
            <a asp-action="MyTickets" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
