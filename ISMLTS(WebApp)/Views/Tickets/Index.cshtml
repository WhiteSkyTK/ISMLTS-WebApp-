@model IEnumerable<ISMLTS_WebApp_.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
}

<h1>Tickets</h1>
<table class="table">
    <thead><tr><th>Student</th><th>Module</th><th>Subject</th><th>Status</th><th>Opened</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Student?.FullName</td>
                <td>@t.Module?.Code</td>
                <td>@t.Subject</td>
                <td>
                    @if (t.Status == "Open")
                    {
                        <span class="badge bg-danger">Open</span>
                    }
                    else if (t.Status == "In Progress")
                    {

                        <span class="badge bg-warning text-dark">In Progress</span>
                    }
                    else
                    {

                        <span class="badge bg-success">Resolved</span>
                    }
                </td>
                <td>@t.DateOpened.ToString("dd MMM, HH:mm")</td>
                <td><a asp-action="Respond" asp-route-id="@t.TicketId" class="btn btn-rosebank btn-sm">Respond</a></td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p class="text-muted">No tickets yet.</p>
}