@model Ticket
@{
    ViewData["Title"] = "Respond to Ticket";
    var subtitle = $"{Model.Student?.FullName} · {Model.Module?.Code} · opened {Model.DateOpened.ToLocalTime():dd MMM yyyy, HH:mm}";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = Model.Subject, Subtitle = subtitle, BackUrl = Url.Action("Index"), BackText = "Tickets" }' />

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <h2 class="h5"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Question <partial name="_TicketStatus" model="Model.Status" /></h2>
            <p class="ticket-message mb-0">@Model.Description</p>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <form asp-action="Respond" asp-route-id="@Model.TicketId" method="post">
                <div class="mb-3">
                    <label for="lecturerResponse" class="form-label">Your reply</label>
                    <textarea id="lecturerResponse" name="lecturerResponse" class="form-control" rows="6" maxlength="1000">@Model.LecturerResponse</textarea>
                    <span asp-validation-for="LecturerResponse" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                        <option value="In Progress" selected="@(Model.Status == "In Progress")">In progress</option>
                        <option value="Resolved" selected="@(Model.Status == "Resolved")">Resolved</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-rosebank" data-loading="Saving…"><i class="bi bi-send" aria-hidden="true"></i> Save reply</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
