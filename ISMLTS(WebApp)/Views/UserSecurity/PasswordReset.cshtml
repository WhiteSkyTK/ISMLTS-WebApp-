@model PasswordResetViewModel
@{
    ViewData["Title"] = "Password reset";
}

<partial name="_PageHeader" model='new PageHeaderModel { Title = "Password reset", Subtitle = Model.Name, BackUrl = Model.BackUrl, BackText = "Back" }' />

<div class="panel form-panel">
    <p>Give @Model.Name this temporary password. It is shown only once.</p>
    <dl class="row detail-list">
        <dt class="col-sm-4">Logs in as</dt>
        <dd class="col-sm-8">@Model.Login</dd>
        <dt class="col-sm-4">Temporary password</dt>
        <dd class="col-sm-8"><code class="temp-password">@Model.TemporaryPassword</code></dd>
    </dl>
    <p class="small text-muted"><i class="bi bi-info-circle" aria-hidden="true"></i> After logging in with it they have to choose a new password before they can do anything else. Two-factor sign-in, if they use it, still applies.</p>
    <div class="form-actions">
        <a href="@Model.BackUrl" class="btn btn-rosebank"><i class="bi bi-check-lg" aria-hidden="true"></i> Done</a>
    </div>
</div>
